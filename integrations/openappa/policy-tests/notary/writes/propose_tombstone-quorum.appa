# propose_tombstone from a fresh trajectory, which starts trusted and
# public. Replay only proposes calls: nothing runs.

# A draft can complete a quorum of agent sessions' drafts (the same
# literals, from different angles, within 15 minutes) and mint a TB with
# no person, so it needs trusted data, as every truth write does. With
# targetRef the result can be the drafter's earlier open draft, and a
# quorum's TB carries other sessions' claim and evidence: the result keeps
# the trajectory's trust (a rule that requires trusted data can't lower
# it; see the battery README's limits) and is restricted to self.
mcp/stenographer/propose_tombstone {
  claim: "LOG_BUDGET 30 is dead; the budget is 100"
  evidence: [{"kind": "commit", "ref": "a1b2c3", "detail": "config.ts sets LOG_BUDGET = 100"}]
  literals: [{"subject": "LOG_BUDGET", "dead": "30", "current": "100"}]
  targetRef: "src/config.ts#LOG_BUDGET"
}
expect allow

# So the next truth write still runs from the same trajectory.
mcp/stenographer/assert_uv {
  assertion: "The nightly export job reads LOG_BUDGET once, at start-up."
  basis: "export.ts calls loadConfig() before the loop and never again."
  verifyBy: {"kind": "command", "value": "grep -n loadConfig src/export.ts"}
}
expect allow

# The result is restricted to self.
mcp/mail/send {
  to: "public"
}
expect deny
