# Every ledger write from one trajectory that starts trusted and public.
# Replay only proposes calls: nothing runs, and each result is empty. Under
# this root a review approves only the `hitl` mark.

# A draft for a person to notarize. The result echoes it.
mcp/stenographer/propose_tombstone {
  claim: "LOG_BUDGET 30 is dead; the budget is 100"
  evidence: [{"kind": "commit", "ref": "a1b2c3", "detail": "config.ts sets LOG_BUDGET = 100"}]
  literals: [{"subject": "LOG_BUDGET", "dead": "30", "current": "100"}]
  rationale: "config.ts was bumped in a1b2c3"
}
expect allow

# Ledger writes from trusted data run.
mcp/stenographer/assert_uv {
  assertion: "The nightly export job reads LOG_BUDGET once, at start-up."
  basis: "export.ts calls loadConfig() before the loop and never again."
  verifyBy: {"kind": "command", "value": "grep -n loadConfig src/export.ts"}
}
expect allow

# A UV that contests a TB is a truth write like any other.
mcp/stenographer/assert_uv {
  assertion: "LOG_BUDGET is still 30 in the production overlay."
  basis: "deploy/prod.env was not part of a1b2c3."
  verifyBy: {"kind": "inspect", "value": "deploy/prod.env"}
  contests: "01J9V1TB000000000000000000"
}
expect allow

# The operator profile's spelling names its author; the rule is the same.
mcp/stenographer/assert_uv {
  assertion: "The nightly export job reads LOG_BUDGET once, at start-up."
  basis: "export.ts calls loadConfig() before the loop and never again."
  verifyBy: {"kind": "command", "value": "grep -n loadConfig src/export.ts"}
  author: "alice"
}
expect allow

# Settling a UV from trusted data runs.
mcp/stenographer/resolve_uv {
  uvId: "01J9V1UV000000000000000000"
  resolution: "refuted"
  evidence: [{"kind": "commit", "ref": "a1b2c3", "detail": "config.ts sets LOG_BUDGET = 100"}]
}
expect allow

# With --allow-agent-assert, the agent profile asserts a TB under the agent identity.
mcp/stenographer/assert_tombstone {
  claim: "LOG_BUDGET 30 is dead; the budget is 100"
  evidence: [{"kind": "commit", "ref": "a1b2c3", "detail": "config.ts sets LOG_BUDGET = 100"}]
  literals: [{"subject": "LOG_BUDGET", "dead": "30", "current": "100"}]
}
expect allow

# Filing a team wiki's lines needs trusted data, and the person reviews
# it: the file can override or strike TBs in its writers' names.
mcp/stenographer/import_wiki_entries {
  file: "team.jsonl"
}
expect authority stenographer-notary

# So does the legacy migration.
mcp/stenographer/backfill_legacy_tombstones {}
expect allow

# Exporting into a wiki file needs trusted data; it returns counts.
mcp/stenographer/export_wiki_entries {
  file: "team.jsonl"
}
expect allow

# A TB signed with a person's name: trusted data is not enough, the person
# reviews this exact call.
mcp/stenographer/assert_tombstone {
  claim: "LOG_BUDGET 30 is dead; the budget is 100"
  evidence: [{"kind": "commit", "ref": "a1b2c3", "detail": "config.ts sets LOG_BUDGET = 100"}]
  literals: [{"subject": "LOG_BUDGET", "dead": "30", "current": "100"}]
  signedBy: "alice"
}
expect authority stenographer-notary

# Verifying a contest mints a successor TB under a person's signature.
mcp/stenographer/resolve_uv {
  uvId: "01J9V1UV000000000000000000"
  resolution: "verified"
  evidence: [{"kind": "commit", "ref": "a1b2c3", "detail": "config.ts sets LOG_BUDGET = 100"}]
  author: "alice"
  signedBy: "alice"
  opinion: "prod.env still sets 30; the TB is overridden."
}
expect authority stenographer-notary

# The notary act mints a draft as truth under a person's name.
mcp/stenographer/sign_proposal {
  proposalId: "01J9PROPTB0000000000000000"
  signedBy: "alice"
}
expect authority stenographer-notary

# A dismissal is a ruling in a person's name.
mcp/stenographer/dismiss_proposal {
  proposalId: "01J9PROPTB0000000000000000"
  dismissedBy: "alice"
  reason: "Duplicate of the TB signed yesterday."
}
expect authority stenographer-notary

# The force path is a person's act.
mcp/stenographer/override_tombstone {
  tbId: "01J9V1TB000000000000000000"
  evidence: [{"kind": "commit", "ref": "a1b2c3", "detail": "config.ts sets LOG_BUDGET = 100"}]
  note: "Rolled back in b4d5e6."
  author: "alice"
}
expect authority stenographer-notary

# A ruling is a person's act.
mcp/stenographer/file_ruling {
  kind: "strike"
  opinion: "The UV restates a TB and adds nothing."
  target: "01J9V1UV000000000000000000"
  author: "alice"
}
expect authority stenographer-notary

# So is a ruling on an objection.
mcp/stenographer/rule_on_objection {
  objectionId: "01J9V1OBJ00000000000000000"
  outcome: "sustained"
  opinion: "The session set LOG_BUDGET back to 30."
  author: "alice"
}
expect authority stenographer-notary

# No write result lowered the trust: a write's result is the record of the
# write, at the session's trust.
mcp/shell/run_command {
  command: "npm test"
}
expect allow

# Results that carry ledger entries are restricted to self.
mcp/mail/send {
  to: "public"
}
expect deny

mcp/mail/send {
  to: "self"
}
expect allow
