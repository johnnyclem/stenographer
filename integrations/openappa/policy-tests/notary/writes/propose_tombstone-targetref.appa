# propose_tombstone with targetRef from a fresh trajectory, which starts
# trusted and public. Replay only proposes calls: nothing runs.

# With targetRef, the result can be the drafter's earlier open draft for the
# same target, which another session under the same agent identity may have
# written. A draft is not truth: it needs no trust.
mcp/stenographer/propose_tombstone {
  claim: "LOG_BUDGET 30 is dead; the budget is 100"
  evidence: [{"kind": "commit", "ref": "a1b2c3", "detail": "config.ts sets LOG_BUDGET = 100"}]
  literals: [{"subject": "LOG_BUDGET", "dead": "30", "current": "100"}]
  targetRef: "src/config.ts#LOG_BUDGET"
}
expect allow

# That result is suspicious: a ledger write now has no remedy under this root.
mcp/stenographer/assert_uv {
  assertion: "The nightly export job reads LOG_BUDGET once, at start-up."
  basis: "export.ts calls loadConfig() before the loop and never again."
  verifyBy: {"kind": "command", "value": "grep -n loadConfig src/export.ts"}
}
expect deny
