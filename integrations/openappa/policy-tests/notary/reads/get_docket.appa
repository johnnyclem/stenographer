# get_docket from a fresh trajectory, which starts trusted and public.
# Replay only proposes calls: nothing runs, and each result is empty.

# The review docket: everything that waits on a person, each item with its
# evidence, approvals, derivation tree and the record's passages. A read
# has no requirement: it runs.
mcp/stenographer/get_docket {
}
expect allow

# Its items are claims written outside this trajectory (agents' UVs and
# drafts, the detector's reviews), so it is suspicious: a ledger write now
# has no remedy under this root.
mcp/stenographer/assert_uv {
  assertion: "The nominated UV on the docket is right."
  basis: "Three agent sessions found it."
  verifyBy: {"kind": "inspect", "value": "src/retry.ts"}
}
expect deny

# It is restricted to self: it cannot go to a public destination.
mcp/mail/send {
  to: "public"
}
expect deny

# The person running the session can receive it.
mcp/mail/send {
  to: "self"
}
expect allow
