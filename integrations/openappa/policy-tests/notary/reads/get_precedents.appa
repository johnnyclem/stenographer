# get_precedents from a fresh trajectory, which starts trusted and public.
# Replay only proposes calls: nothing runs, and each result is empty.

# A person's standing policy decisions, each with its written opinion.
# A read has no requirement: it runs.
mcp/stenographer/get_precedents {
  scope: "ci"
}
expect allow

# Their opinions were written outside this trajectory, so it is
# suspicious: a ledger write now has no remedy under this root.
mcp/stenographer/assert_uv {
  assertion: "Merging on red is never allowed."
  basis: "The precedent ci.merge-on-red says so."
  verifyBy: {"kind": "inspect", "value": ".github/workflows/ci.yml"}
}
expect deny

# It is restricted to self: it cannot go to a public destination.
mcp/mail/send {
  to: "public"
}
expect deny

# The person running the session can receive it.
mcp/mail/send {
  to: "self"
}
expect allow
