{
  "name": "@stenographer/core",
  "version": "0.1.0-alpha.2",
  "description": "MCP court reporter — queryable conversation index with GraphRAG",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
