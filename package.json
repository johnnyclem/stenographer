{
  "name": "@stenographer/core",
  "version": "0.1.0-alpha.2",
  "description": "MCP court reporter — queryable conversation index with GraphRAG",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "dist-cli"
  ],
  "bin": {
    "stenographer": "./dist-cli/index.js"
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.cli.json",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^11.0.0",
    "sqlite-vec": "^0.1.9",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.11.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "overrides": {
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.2",
    "ip-address": "^10.5.0",
    "body-parser": "^2.3.0",
    "fast-uri": "^3.1.5"
  }
}
